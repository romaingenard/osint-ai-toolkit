# Corpus d'entités — "Narratifs anti-français au Sahel 2025-2026".
# Les lignes commençant par # sont des exemples non parsés. Retirer le # pour activer une entité.
# producer_category : A (russes) / B (institutionnels AES) / C (amplificateurs cooptés) / D (locaux autonomie variable).
# country : MLI / BFA / NER / SUPRA (supra-national).
# collector : wordpress_api / html_generic / telegram_channel / manual_event.
# role : primary (corpus d'analyse) / d3lta_validation (doublon multilingue pour validation reformulation).
# default_language : code ISO 639-1 (fr, ru, en, ar). Choix éditorial par entité, pas de détection automatique.
# Pour une entité multilingue (ex : afrinz.ru FR + RU), créer deux entités distinctes avec slugs distincts.
entity_id,name,url,platform,producer_category,country,collector,html_title_selector,html_date_selector,html_content_selector,rate_limit_seconds,status,default_language,role,notes
